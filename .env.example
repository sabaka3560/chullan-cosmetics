# Copy to `.env.local` for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for deploys.
#
# NOTE THE ABSENT `VITE_` PREFIX. That prefix is exactly how Vite inlines a
# value into client JavaScript, so adding it to anything here would publish the
# credential it is meant to protect. Nothing in this file may ever be prefixed.
#
# `.env.local` is gitignored. Never commit real values.

# ─── Shiprocket (shipping + serviceability) ─────────────────────────────────
# Create a DEDICATED API user in the panel under Settings → API → Configure.
# This is deliberately NOT your login: it can be rotated without locking anyone
# out, and it limits what a leak exposes.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=

# The verified pickup location serviceability is measured from. Six digits.
SHIPROCKET_PICKUP_PINCODE=

# The pickup address NICKNAME, exactly as it appears in the panel — this is a
# label, not an address, and Shiprocket matches it character for character.
# Order creation fails without it. Call /api/pickup-locations to list them.
SHIPROCKET_PICKUP_LOCATION=

# Optional. Defaults to https://apiv2.shiprocket.in/v1/external — set it only to
# point at a different Shiprocket environment.
SHIPROCKET_BASE_URL=

# ─── Razorpay (checkout + payment) ──────────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys (`rzp_test_…`) work immediately on
# signup with no KYC, against the real API — use them until you go live.
#
# KEY_ID is published to the browser by design; Checkout needs it to identify
# the merchant. KEY_SECRET signs orders and verifies payment signatures and must
# never leave the server, which is why neither carries a VITE_ prefix.
#
# Enable Magic Checkout in the dashboard and pick "Custom E-Commerce Platform".
# Under Shipping Setup choose "API" and point it at:
#     https://<your-domain>/api/shipping-info
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs the `payment.captured` webhook, which places the order when the buyer's
# browser never came back — a closed tab, a sleeping phone, a tunnel. Without
# that endpoint those payments are taken with nothing shipped behind them.
#
# Generate any long random value (`openssl rand -hex 32`) and paste the SAME
# value into Razorpay → Settings → Webhooks. Register the production endpoint
# as `https://<your-domain>/api/webhooks/razorpay` for `payment.captured` only.
RAZORPAY_WEBHOOK_SECRET=

# ─── Development ────────────────────────────────────────────────────────────
# Set to exactly `mock` to run the whole purchase flow with no Shiprocket or
# fastrr account: serviceability returns plausible varying answers and checkout
# redirects to a clearly-labelled test confirmation. Anything other than the
# exact string `mock` leaves both routes on the real integrations.
#
# NEVER set this in the production environment. A fabricated delivery date
# shown to a real buyer is a promise the business cannot keep.
COMMERCE_MODE=
